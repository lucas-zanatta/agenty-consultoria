# ── Voyage AI (embeddings para RAG) ──────────────────────────────────────────
VOYAGE_API_KEY=pa-...

# ── Supabase (mesmo projeto do gestor-reputacao) ──────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
