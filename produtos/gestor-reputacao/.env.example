# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL e service_role key
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ── Stripe ────────────────────────────────────────────────────────────────────
# Desenvolvedores → Chaves de API → Chave secreta
STRIPE_SECRET_KEY=sk_live_...
# Desenvolvedores → Webhooks → Segredo do webhook de assinatura
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Google OAuth — app da Agenty (único para todos os clientes) ───────────────
# console.cloud.google.com → Credenciais → OAuth 2.0 → App da Web
# URI de redirecionamento: https://seu-app.up.railway.app/oauth/callback
GOOGLE_CLIENT_ID=340988086097-xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# ── SMTP — conta Gmail da Agenty (envia e-mails para todos os clientes) ───────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx   # Senha de App do Gmail

# ── Servidor ──────────────────────────────────────────────────────────────────
APP_BASE_URL=https://seu-app.up.railway.app   # URL pública do Railway
PORT=8000
CHECK_INTERVAL_HOURS=2
